rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isValidPool(pool) {
      return pool.keys().hasAll(['id', 'name', 'code', 'creatorId', 'creatorName', 'createdAt'])
             && pool.id is string && pool.id.size() <= 128
             && pool.name is string && pool.name.size() <= 100
             && pool.code is string && pool.code.size() <= 20
             && pool.creatorId is string && pool.creatorId.size() <= 128
             && pool.creatorName is string && pool.creatorName.size() <= 100
             && (!pool.keys().hasAny(['description']) || (pool.description is string && pool.description.size() <= 500))
             && (!pool.keys().hasAny(['results']) || pool.results is map)
             && (!pool.keys().hasAny(['activeQuestions']) || pool.activeQuestions is list)
             && (!pool.keys().hasAny(['customPoints']) || pool.customPoints is map)
             && (!pool.keys().hasAny(['tiebreakerResult']) || pool.tiebreakerResult is string)
             && (!pool.keys().hasAny(['deadline']) || pool.deadline != null)
             && (!pool.keys().hasAny(['entryFee']) || (pool.entryFee is number || pool.entryFee is int || pool.entryFee is float))
             && (!pool.keys().hasAny(['duesNote']) || (pool.duesNote is string && pool.duesNote.size() <= 1000))
             && (!pool.keys().hasAny(['payments']) || pool.payments is map)
             && (!pool.keys().hasAny(['coAdmins']) || pool.coAdmins is list)
             && (!pool.keys().hasAny(['payouts']) || pool.payouts is list);
    }
    function isPoolCreator(pool) {
      return request.auth.uid == pool.creatorId;
    }
    function isPoolCoAdmin(pool) {
      return pool.keys().hasAny(['coAdmins']) && request.auth.uid in pool.coAdmins;
    }
    function isValidPicks(picks) {
      return picks.keys().hasAll(['userId', 'userDisplayName', 'selections', 'updatedAt'])
             && picks.userId is string && picks.userId.size() <= 128
             && picks.userDisplayName is string && picks.userDisplayName.size() <= 100
             && picks.selections is map
             && (!picks.keys().hasAny(['userPhotoURL']) || (picks.userPhotoURL is string && picks.userPhotoURL.size() <= 1000))
             && (!picks.keys().hasAny(['tiebreaker']) || (picks.tiebreaker is string && picks.tiebreaker.size() <= 20));
    }
    
    match /{path=**}/picks/{userId} {
      allow read: if isSignedIn();
    }
    match /pools/{poolId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(poolId)
                    && request.resource.data.id == poolId
                    && isValidPool(request.resource.data)
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if isValidPool(request.resource.data)
                    && isSignedIn()
                    && (isPoolCreator(resource.data) || isPoolCoAdmin(resource.data))
                    && request.resource.data.creatorId == resource.data.creatorId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['results', 'activeQuestions', 'name', 'description', 'code', 'tiebreakerResult', 'customPoints', 'deadline', 'entryFee', 'duesNote', 'payments', 'payouts', 'creatorName', 'coAdmins'])
                    // Only the creator decides who is an admin. Without this a co-admin
                    // could promote others, demote peers, or lock the creator out.
                    && (isPoolCreator(resource.data)
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coAdmins']))
                    // creatorName is the creator's own display name, synced by profileSync.
                    && (isPoolCreator(resource.data)
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorName']));
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.creatorId;
      match /picks/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && userId == request.auth.uid
                      && isValidId(userId)
                      && isValidPicks(request.resource.data)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.updatedAt == request.time
                      && exists(/databases/$(database)/documents/pools/$(poolId));
        allow update: if isValidPicks(request.resource.data)
                      && isSignedIn()
                      && userId == request.auth.uid
                      && request.auth.uid == resource.data.userId
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.updatedAt == request.time
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selections', 'userDisplayName', 'userPhotoURL', 'updatedAt', 'tiebreaker']);
        allow delete: if isSignedIn()
                      && (userId == request.auth.uid || get(/databases/$(database)/documents/pools/$(poolId)).data.creatorId == request.auth.uid || (get(/databases/$(database)/documents/pools/$(poolId)).data.keys().hasAny(['coAdmins']) && request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.coAdmins));
      }
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
      }
    }
  }
}
